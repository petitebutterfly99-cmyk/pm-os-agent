# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your model provider key (OpenAI shown; adapt for your provider).
OPENAI_API_KEY=sk-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=gpt-4o-mini      # use a cheap, fast model; a full run is ~cents
CORTEX_CRITIC_MODEL=gpt-4o    # stronger model for the critic; nuanced classification
                               # judgment showed real inconsistency on gpt-4o-mini
CORTEX_MAX_ITERATIONS=12      # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.05      # hard spend cap per run, enforced outside the model
CORTEX_DAILY_COST_CAP_USD=1.00  # rolling cap across all runs today, enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run
CORTEX_MAX_READ_CALLS=6       # triage agent: cap on read-only tool calls per run, separate from MAX_ITERATIONS
CORTEX_CALL_TIMEOUT_S=30      # per-API-call timeout, catches a hung request
CORTEX_RUN_DEADLINE_S=120     # wall-clock ceiling per run, catches slow-but-under-cap runs

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=0.15
CORTEX_PRICE_OUT_PER_M=0.60
# Same, for CORTEX_CRITIC_MODEL, a different (pricier) model than CORTEX_MODEL.
CORTEX_CRITIC_PRICE_IN_PER_M=2.50
CORTEX_CRITIC_PRICE_OUT_PER_M=10.00
